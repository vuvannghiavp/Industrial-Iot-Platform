# Environment files and credentials
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
**/certs/
**/passwd
**/*.pem
**/*.key
**/*private*.crt
!gateway-pi/certs/
!gateway-pi/certs/AmazonRootCA1.pem
!gateway-pi/certs/certificate.pem.crt

# ESP-IDF generated output and local configuration (may contain credentials)
**/build/
**/sdkconfig
**/sdkconfig.old

# Python-generated files
__pycache__/
**/__pycache__/
*.py[cod]

# Gateway persistent data
gateway-pi/data/
**/*.sqlite3
**/*.sqlite3-shm
**/*.sqlite3-wal
