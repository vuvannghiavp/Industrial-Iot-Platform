# Replace every placeholder before starting the stack. Use URL-safe hex for
# POSTGRES_PASSWORD so DATABASE_URL does not need percent-encoding.
POSTGRES_DB=smarthome
POSTGRES_USER=smarthome
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
DATABASE_URL=postgresql+psycopg://smarthome:REPLACE_WITH_RANDOM_HEX_PASSWORD@timescaledb:5432/smarthome
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MQTT_ENABLED=false
AWS_IOT_ENDPOINT=xxxxxxxxxxxx-ats.iot.ap-southeast-1.amazonaws.com
AWS_IOT_CA_FILE=/run/secrets/aws/AmazonRootCA1.pem
AWS_IOT_CERT_FILE=/run/secrets/aws/device-certificate.pem.crt
AWS_IOT_KEY_FILE=/run/secrets/aws/private.pem.key
MQTT_TOPIC_PREFIX=smarthome
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
