# URL của FastAPI Backend (mặc định: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# URL của WebSocket endpoint (tùy chọn, nếu để trống sẽ tự suy ra từ VITE_API_BASE_URL: ws://localhost:8000)
# VITE_WS_BASE_URL=

# Chu kỳ gửi chuỗi "ping" duy trì kết nối WebSocket (mili-giây, mặc định: 25000)
VITE_WS_PING_INTERVAL_MS=25000
